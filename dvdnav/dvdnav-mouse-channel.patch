 /*****************************************************************************
  * Demux:
  *****************************************************************************/
+/*****************************************************************************
+ * MouseThread: accept "x y [click]" on loopback and park the coordinate.
+ *****************************************************************************
+ * Deliberately does NO dvdnav work -- see the comment on demux_sys_t.mouse.
+ *****************************************************************************/
+static void *MouseThread( void *data )
+{
+    (void)data;
+
+
+    for( ;; )
+    {
+        /* Plain accept(), NOT net_Accept(): net_Accept never returned here even
+         * though connect() succeeded -- and connect() succeeding proves only
+         * that the kernel queued it on the listen backlog, not that anyone
+         * accepted it. accept() is a pthread cancellation point, so vlc_cancel
+         * + vlc_join in Close() still tears this down cleanly. */
+        /* net_ListenTCP() returns a NON-BLOCKING socket, so a bare accept()
+         * returns -1/EAGAIN immediately and the connection just sits on the
+         * backlog unaccepted -- which is why connect() always succeeded while
+         * nothing was ever read. Wait for readability first. poll() is also a
+         * cancellation point, so Close()'s vlc_cancel still tears this down. */
+        struct pollfd pfd = { .fd = exdvd_fds[0], .events = POLLIN };
+        int pr = poll( &pfd, 1, -1 );
+        if( pr < 0 )
+        {
+            if( errno == EINTR )
+                continue;
+            break;
+        }
+        int fd = accept( exdvd_fds[0], NULL, NULL );
+        if( fd >= 0 )
+        {
+            /* BSD/macOS: accept() INHERITS O_NONBLOCK from the listening
+             * socket, so recv() returned EAGAIN instantly and the read loop
+             * never ran -- the connection was accepted and dropped unread.
+             * Clear it explicitly; do not assume a fresh fd is blocking. */
+            int fl = fcntl( fd, F_GETFL, 0 );
+            if( fl != -1 )
+                fcntl( fd, F_SETFL, fl & ~O_NONBLOCK );
+        }
+        if( fd < 0 )
+        {
+            if( errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK )
+                continue;
+            break;
+        }
+
+        char buf[64];
+        ssize_t n;
+        while( ( n = recv( fd, buf, sizeof(buf) - 1, 0 ) ) > 0 )
+        {
+                buf[n] = '\0';
+            if( buf[0] == '?' )
+            {
+                /* v3: "?" -> "<buttons> <highlight status>\n" */
+                char out[32];
+                int k = snprintf( out, sizeof(out), "%d %d\n",
+                                  exdvd_btn_ns, exdvd_hli_ss );
+                send( fd, out, k, 0 );
+                continue;
+            }
+            int x, y, i_click = 0;
+            if( sscanf( buf, "%d %d %d", &x, &y, &i_click ) >= 2 )
+            {
+                vlc_mutex_lock( &exdvd_lock );
+                exdvd_x = x; exdvd_y = y;
+                exdvd_click = i_click != 0;
+                exdvd_pending = true;
+                vlc_mutex_unlock( &exdvd_lock );
+            }
+        }
+        net_Close( fd );
+    }
+    return NULL;   /* the listening socket failed: no more taps this process */
+}
+
+/*****************************************************************************
+ * MouseDeliver: apply a parked coordinate, on the demux thread.
+ *****************************************************************************
+ * Same two calls upstream's EventMouse makes, from the thread that owns dvdnav.
+ *****************************************************************************/
+static void MouseDeliver( demux_t *p_demux )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+
+    {
+        pci_t *cur = dvdnav_get_current_nav_pci( p_sys->dvdnav );
+        exdvd_btn_ns = cur ? (int)cur->hli.hl_gi.btn_ns : -1;
+        exdvd_hli_ss = cur ? (int)cur->hli.hl_gi.hli_ss : -1;
+    }
+
+    vlc_mutex_lock( &exdvd_lock );
+    bool b_pending = exdvd_pending;
+    bool b_click   = exdvd_click;
+    int  x = exdvd_x, y = exdvd_y;
+    exdvd_pending = false;
+    vlc_mutex_unlock( &exdvd_lock );
+
+    if( !b_pending )
+        return;
+
+    pci_t *pci = dvdnav_get_current_nav_pci( p_sys->dvdnav );
+    fprintf( stderr, "exdvd: %d,%d %s (pci=%p, %d buttons)\n", x, y,
+             b_click ? "activate" : "select", (void *)pci,
+             pci ? (int)pci->hli.hl_gi.btn_ns : -1 ); fflush( stderr );
+    if( pci == NULL )
+        return;
+
+    if( b_click )
+    {
+        ButtonUpdate( p_demux, true );
+        dvdnav_mouse_activate( p_sys->dvdnav, pci, x, y );
+    }
+    else
+        dvdnav_mouse_select( p_sys->dvdnav, pci, x, y );
+}
